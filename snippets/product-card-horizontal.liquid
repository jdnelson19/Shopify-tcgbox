{% assign variant_input_id = 'variant-' | append: section.id | append: '-' | append: product.id %}
{% assign custom_input_id = 'custom-' | append: section.id | append: '-' | append: product.id %}
{% assign custom_text_tag = settings.custom_text_product_tag | default: 'custom-text' %}

<article class="product-card product-card--horizontal">
  <a class="product-card__media-link" href="{{ product.url }}">
    <div class="product-card__media product-card__media--horizontal">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.title }}
      {% endif %}
    </div>
  </a>

  <div class="product-card__body stack-sm">
    <div class="stack-sm">
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
      <div class="product-card__price">{{ product.price | money }}</div>
      <p class="product-card__excerpt">
        {{ product.description | strip_html | strip_newlines | truncate: 105 }}
      </p>
    </div>

    {% form 'product', product, class: 'product-card__form stack-sm js-variant-form' %}
      {% if product.variants.size > 1 %}
        {% for option in product.options_with_values %}
          <div class="stack-sm">
            <label for="{{ variant_input_id }}-{{ forloop.index0 }}">{{ option.name }}</label>
            <select id="{{ variant_input_id }}-{{ forloop.index0 }}" data-variant-option data-option-index="{{ forloop.index0 }}">
              {% for value in option.values %}
                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id-input>
        <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endif %}

      {% if product.tags contains custom_text_tag %}
        <div class="stack-sm">
          <label for="{{ custom_input_id }}">Custom text (max 12)</label>
          <input
            id="{{ custom_input_id }}"
            type="text"
            name="properties[Custom Text]"
            maxlength="12"
            pattern=".{0,12}"
            placeholder="Optional"
          >
        </div>
      {% endif %}

      <button
        class="button button--accent"
        type="submit"
        data-add-to-cart-label="{{ 'products.product.add_to_cart' | t }}"
        data-sold-out-label="{{ 'products.product.sold_out' | t }}"
        {% unless product.available %}disabled{% endunless %}
      >
        {% if product.available %}
          {{ 'products.product.add_to_cart' | t }}
        {% else %}
          {{ 'products.product.sold_out' | t }}
        {% endif %}
      </button>
    {% endform %}
  </div>
</article>