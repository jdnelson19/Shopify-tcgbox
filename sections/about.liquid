<section class="section about-section">
  <div class="container">
    <div class="about-card">
      <div class="stack-sm">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="about-copy">{{ section.settings.text }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About TCG Box"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are collectors serving collectors, focused on trusted products, quick shipping, and fair support.</p>"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
