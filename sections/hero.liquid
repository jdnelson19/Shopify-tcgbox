<section class="hero section">
  <div class="page-shell">
    <div class="hero-card hero-banner">
      <div class="hero-media hero-banner-media">
        {% if section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', alt: section.settings.heading }}
        {% else %}
          <div class="hero-placeholder">Upload a hero image in Theme Editor</div>
        {% endif %}
      </div>

      <div class="hero-overlay">
        <div class="stack-sm hero-content hero-copy">
          {% if section.settings.kicker != blank %}
            <span class="hero-kicker">{{ section.settings.kicker }}</span>
          {% endif %}

          <h1>{{ section.settings.heading }}</h1>
          <p>{{ section.settings.subheading }}</p>

          <div class="hero-actions">
            {% if section.settings.button_label != blank and section.settings.button_link != blank %}
              <a class="button button--accent" href="{{ section.settings.button_link }}">
                {{ section.settings.button_label }}
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}
              <a class="button button--ghost" href="{{ section.settings.secondary_button_link }}">
                {{ section.settings.secondary_button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Trusted by collectors"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Next Hit Pull Is Here"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated booster boxes, preorders, and sealed products for collectors and competitive players."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "View preorders"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}