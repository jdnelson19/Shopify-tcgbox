<section class="section">
  <div class="container stack-sm cart-page" data-cart-page>
    <h1>Cart</h1>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer__items" data-cart-page-items>
        {% for item in cart.items %}
          <article class="cart-drawer-item cart-page-item">
            <a href="{{ item.url }}" class="cart-drawer-item__image">
              {% if item.image %}
                {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}
              {% endif %}
            </a>

            <div class="stack-sm">
              <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
              {% unless item.product.has_only_default_variant %}
                <div class="cart-drawer-item__meta">{{ item.variant.title }}</div>
              {% endunless %}

              {% if item.properties != blank %}
                <div class="cart-drawer-item__meta">
                  {% for property in item.properties %}
                    {% assign first_character_in_key = property.first | slice: 0 %}
                    {% if property.last != blank and first_character_in_key != '_' %}
                      <div>{{ property.first }}: {{ property.last }}</div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="cart-drawer-item__price">{{ item.final_line_price | money }}</div>

              <div class="cart-qty" data-line-index="{{ forloop.index }}" data-line-key="{{ item.key }}" data-cart-page-qty>
                <button type="button" class="cart-qty__button" data-qty-change="decrease" aria-label="Decrease quantity">←</button>
                <span class="cart-qty__value">{{ item.quantity }}</span>
                <button type="button" class="cart-qty__button" data-qty-change="increase" aria-label="Increase quantity">→</button>
              </div>

              <button type="button" class="cart-drawer-item__remove" data-remove-line="{{ forloop.index }}" data-line-key="{{ item.key }}">Remove</button>
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="cart-drawer__footer cart-page-footer">
        <div class="stack-sm" style="max-width: 320px;">
          <div><strong>Subtotal: {{ cart.total_price | money }}</strong></div>
          <a class="button button--ghost" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
          <a class="button button--accent" href="{{ routes.cart_url }}/checkout">Checkout</a>
        </div>
      </div>
    {% else %}
      <p>Your cart is currently empty.</p>
      <a class="button button--accent" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}