<section class="section">
  <div class="container stack-sm">
    <h1>Cart</h1>

    {% if cart.item_count > 0 %}
      {% form 'cart', cart %}
        <div class="stack-sm">
          {% for item in cart.items %}
            <article class="product-card" style="display:grid;grid-template-columns:120px 1fr;gap:0.8rem;align-items:center;">
              <a href="{{ item.url }}">
                <div class="product-card__media" style="aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden;">
                  {% if item.image %}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title }}
                  {% endif %}
                </div>
              </a>

              <div class="stack-sm" style="padding: 0.8rem 0.8rem 0.8rem 0;">
                <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                {% unless item.product.has_only_default_variant %}
                  <div>{{ item.variant.title }}</div>
                {% endunless %}

                {% if item.properties != blank %}
                  <div>
                    {% for property in item.properties %}
                      {% assign first_character_in_key = property.first | slice: 0 %}
                      {% if property.last != blank and first_character_in_key != '_' %}
                        <div>{{ property.first }}: {{ property.last }}</div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div>{{ item.final_line_price | money }}</div>
                <div class="stack-sm" style="max-width: 140px;">
                  <label for="Updates_{{ item.key }}">Quantity</label>
                  <input id="Updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                </div>

                <div>
                  <a href="{{ item.url_to_remove }}">Remove</a>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="stack-sm" style="margin-top: 1rem; max-width: 320px;">
          <div><strong>Subtotal: {{ cart.total_price | money }}</strong></div>
          <button type="submit" name="update" class="button button--ghost">Update cart</button>
          <button type="submit" name="checkout" class="button button--accent">Checkout</button>
        </div>
      {% endform %}
    {% else %}
      <p>Your cart is currently empty.</p>
      <a class="button button--accent" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}