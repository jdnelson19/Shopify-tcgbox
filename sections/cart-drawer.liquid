<aside class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__backdrop" data-close-cart-drawer></div>

  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
    <div class="cart-drawer__header">
      <h2>Cart</h2>
      <button type="button" class="cart-drawer__close" data-close-cart-drawer aria-label="Close cart">×</button>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {% if cart.item_count > 0 %}
        <div class="cart-drawer__items" data-cart-items>
          {% for item in cart.items %}
            <article class="cart-drawer-item">
              <a href="{{ item.url }}" class="cart-drawer-item__image">
                {% if item.image %}
                  {{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.product.title }}
                {% endif %}
              </a>

              <div class="stack-sm">
                <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                {% unless item.product.has_only_default_variant %}
                  <div class="cart-drawer-item__meta">{{ item.variant.title }}</div>
                {% endunless %}

                {% if item.properties != blank %}
                  <div class="cart-drawer-item__meta">
                    {% for property in item.properties %}
                      {% assign first_character_in_key = property.first | slice: 0 %}
                      {% if property.last != blank and first_character_in_key != '_' %}
                        <div>{{ property.first }}: {{ property.last }}</div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="cart-drawer-item__price">{{ item.final_line_price | money }}</div>

                <div class="cart-qty" data-line-index="{{ forloop.index }}" data-line-key="{{ item.key }}">
                  <button type="button" class="cart-qty__button" data-qty-change="decrease" aria-label="Decrease quantity">←</button>
                  <span class="cart-qty__value">{{ item.quantity }}</span>
                  <button type="button" class="cart-qty__button" data-qty-change="increase" aria-label="Increase quantity">→</button>
                </div>

                <button type="button" class="cart-drawer-item__remove" data-remove-line="{{ forloop.index }}" data-line-key="{{ item.key }}">Remove</button>
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="cart-drawer__footer" data-cart-summary>
          <div class="cart-drawer__subtotal">Subtotal: {{ cart.total_price | money }}</div>
          <a class="button button--ghost" href="{{ routes.cart_url }}">View cart</a>
          <a class="button button--accent" href="{{ routes.cart_url }}" data-drawer-checkout>Checkout</a>
        </div>
      {% else %}
        <div class="cart-drawer__empty" data-cart-empty>
          <p>Your cart is currently empty.</p>
          <a class="button button--accent" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
        </div>
      {% endif %}
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
